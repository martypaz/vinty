{
  "name": "vinty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scan": "tsx --env-file-if-exists=.env src/cli.ts",
    "price-lookup": "tsx --env-file-if-exists=.env src/priceLookupCli.ts",
    "evaluate": "tsx --env-file-if-exists=.env src/profitCalculatorCli.ts",
    "notify": "tsx --env-file-if-exists=.env src/slackNotifierCli.ts",
    "api": "tsx --env-file-if-exists=.env src/serverCli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}
