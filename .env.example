# Copy this file to .env and fill in real values. .env is gitignored and
# never committed.

# Required for `npm run price-lookup`. Get a free key at https://sold-comps.com
SOLDCOMPS_API_KEY=

# Required for `npm run notify` and the Tools tab's "Clear #approvals bot
# posts". Needs the chat:write scope to post; the Tools tab additionally
# needs channels:history to read the channel's history (see README).
SLACK_BOT_TOKEN=

# Required for the Tools tab's "Clear #approvals bot posts" — the Slack
# channel ID (not the #name) of #approvals.
SLACK_APPROVALS_CHANNEL_ID=

# Optional overrides, useful for testing — leave unset to use the real APIs.
# VINTED_BASE_URL=
# SOLDCOMPS_BASE_URL=
# SLACK_CHANNEL=
